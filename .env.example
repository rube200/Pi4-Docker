# Public hostname (FQDN): the TLS certificate, nginx sites, DoH, the Pi-hole web interface,
# the WireGuard client endpoint and the Hostinger DNS zone.
HOST_SERVER_HOSTNAME=your-hostname.com

# Time zone for every container.
# TZ=Europe/Lisbon

# This Pi on the LAN: its network interface and its own addresses. Pi-hole serves DHCP
# on these subnets through the relays, so turn on Pi-hole's DHCP server.
# HOST_LAN_IFACE=eth0
HOST_LAN_IP=192.168.x.x
HOST_LAN_IP6=xxxx:xxxx:xxxx:xxxx::x

# Address each DHCP relay sends from. Unset, it is picked from HOST_LAN_IFACE,
# preferring HOST_LAN_IP and HOST_LAN_IP6; set it only if that picks the wrong one.
# DHCP_LOCAL_IP=
# DHCP_LOCAL_IP6=

# LAN prefixes the host firewall fully trusts: SSH allowed, no rate limits (comma-separated).
# Add your global IPv6 prefix to TRUSTED_PREFIX6 to trust LAN devices that use it.
# TRUSTED_PREFIX=192.168.0.0/16
# TRUSTED_PREFIX6=fd00::/8

# DoH URL path: https://<hostname>:8443/<path>.
# DOH_PATH=consulta-dns

# Addresses internet only WireGuard clients may reach besides the internet and Pi-hole DNS
# (comma-separated). Keep nginx (172.28.0.6, fd28::6) in the list: it serves the websites,
# DoH and DoT, and your hostname sends these clients there. Full access clients reach everything.
# WG_ALLOWLIST=172.28.0.6,fd28::6

# Hostinger API token for host-scripts/ddns-hostinger.sh and certbot-dns-hostinger.sh;
# leave unset if you don't use Hostinger.
# DNS_API=
